    "def average(values):\n    return sum(values) / (len(values) - 1)   # ← bug",
    "sum = 2 + 4 + 6 = 12\nlen = 3\ndenominator = 3 – 1 = 2\naverage = 12 / 2 = 6",
    "from typing import Iterable, TypeVar\nfrom numbers import Real\n\nT = TypeVar(\"T\", bound=Real)\n\n\ndef average(iterable: Iterable[T]) -> float:\n    \"\"\"\n    Return the arithmetic mean of *iterable*.\n\n    The function works with any iterable, including generators.\n    Raises:\n        ValueError: if the iterable is empty.\n    \"\"\"\n    total = 0.0\n    count = 0\n    for value in iterable:\n        total += float(value)\n        count += 1\n\n    if count == 0:\n        raise ValueError(\"average() arg is an empty iterable\")\n    return total / count",
    "import unittest\nfrom typing import Generator\n\n# Assume the corrected average() is imported from avg_module\n# from avg_module import average\n\n\ndef gen_numbers() -> Generator[int, None, None]:\n    for i in (10, 20, 30):\n        yield i\n\n\nclass TestAverage(unittest.TestCase):\n    def test_empty_raises(self):\n        with self.assertRaises(ValueError):\n            average([])\n\n    def test_one_item(self):\n        self.assertAlmostEqual(average([42]), 42.0)\n\n    def test_generator_input(self):\n        self.assertAlmostEqual(average(gen_numbers()), 20.0)\n\n    def test_negative_values(self):\n        self.assertAlmostEqual(average([-5, 0, 5]), 0.0)\n\n\nif __name__ == \"__main__\":\n    unittest.main()",
    "from fastapi import APIRouter, Depends, HTTPException, status\nfrom sqlalchemy.orm import Session\nfrom models import Document  # your SQLAlchemy model\nfrom dependencies import get_db, get_current_user  # typical FastAPI deps\n\nrouter = APIRouter()\n\n\n@router.get(\"/documents/{doc_id}\", response_model=DocumentReadSchema)\ndef read_document(\n    doc_id: int,\n    db: Session = Depends(get_db),\n    current_user = Depends(get_current_user),\n):\n    \"\"\"\n    Return the requested document only if it belongs to the authenticated user.\n    If the document does not exist *or* belongs to another user, raise 404.\n    \"\"\"\n    # Fetch the row without exposing ownership yet\n    doc = db.get(Document, doc_id)\n\n    # If the row is missing **or** the owner does not match, behave identically\n    if doc is None or doc.owner_id != current_user.id:\n        raise HTTPException(\n            status_code=status.HTTP_404_NOT_FOUND,\n            detail=\"Document not found\",\n        )\n\n    return doc"
  ],
