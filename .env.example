# UVMS AI — Stage 1 v1.3 Production Hardening
# Local Windows/default run uses SQLite and no Redis. Docker Compose overrides these.
UVMS_ENV=development
UVMS_DATABASE_URL=sqlite:///./uvms_ai.db
UVMS_JWT_SECRET=CHANGE_ME_GENERATE_32_RANDOM_BYTES
UVMS_ACCESS_TOKEN_MINUTES=30
UVMS_REFRESH_TOKEN_DAYS=30
UVMS_REFRESH_COOKIE_NAME=uvms_refresh
UVMS_REFRESH_COOKIE_SECURE=false
UVMS_REFRESH_COOKIE_DOMAIN=
UVMS_DB_POOL_SIZE=10
UVMS_DB_MAX_OVERFLOW=20
UVMS_REDIS_URL=
UVMS_RATE_LIMIT_ENABLED=true
UVMS_RATE_LIMIT_DEFAULT_PER_MINUTE=180
UVMS_RATE_LIMIT_AUTH_PER_MINUTE=30
UVMS_RATE_LIMIT_AI_PER_MINUTE=60
UVMS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:19006
# Local development allows LAN access for Expo/real-phone testing. Production rejects wildcard hosts.
UVMS_TRUSTED_HOSTS=*
UVMS_BOOTSTRAP_ADMIN_EMAIL=admin@uvms.uz

# Storage
UVMS_STORAGE_DIR=./storage
UVMS_STORAGE_BACKEND=local
UVMS_S3_ENDPOINT_URL=
UVMS_S3_REGION=auto
UVMS_S3_BUCKET=
UVMS_S3_ACCESS_KEY_ID=
UVMS_S3_SECRET_ACCESS_KEY=
UVMS_S3_FORCE_PATH_STYLE=false
UVMS_MAX_UPLOAD_MB=20
# Absolute request envelope; must be >= max upload and <= Nginx client_max_body_size.
UVMS_MAX_REQUEST_MB=105
UVMS_MAX_AUDIO_MB=25
UVMS_MAX_EXTRACTED_TEXT_CHARS=120000

# AI provider: auto = demo without a key, OpenAI when OPENAI_API_KEY is set,
# or OpenRouter in development/demo/test when only OPENROUTER_API_KEY is set.
# Auto prefers OpenAI, then Gemini, Groq, then development-only OpenRouter.
# Explicit demo / openai / openrouter / openai-compatible / gemini / groq modes are supported.
# Explicit live providers require their own key and never silently fall back to demo text.
# openai-compatible must implement the Responses streaming contract (not only Chat Completions).
UVMS_AI_PROVIDER=auto
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Public Beta: Groq text + Whisper; Vision/Qwen are disabled.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-120b
GROQ_MODEL_BALANCED=openai/gpt-oss-120b
GROQ_MODEL_DEEP=openai/gpt-oss-120b
GROQ_VISION_ENABLED=false
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
UVMS_PUBLIC_BETA=true
UVMS_BETA_DAILY_REQUESTS=10
UVMS_BETA_MINUTE_REQUESTS=5
UVMS_BETA_GLOBAL_CONCURRENCY=3
UVMS_BETA_CONTEXT_TOKENS=12000
UVMS_BETA_OUTPUT_TOKENS=1536
UVMS_BETA_EXTENDED_OUTPUT_TOKENS=2048
# Groq Fast/Balanced/Deep use low/medium/high. No search or image generation.
# Legacy adapter configuration below is retained for compatibility, outside the Public Beta scope.
# Gemini uses Chat Completions on the official endpoint; all credentials stay on the backend.
# Set UVMS_AI_PROVIDER=gemini to select it. Old UVMS_MODEL_* and admin DB routes are ignored.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_BALANCED=gemini-3.8-flash
GEMINI_MODEL_DEEP=gemini-3.8-flash
# Gemini effort: Fast=low, Balanced=medium, Deep=high. Vision and file analysis are supported.
# Image generation, transcription and native search are unavailable in this Gemini adapter.
# DEVELOPMENT/DEMO ONLY: UVMS_AI_PROVIDER=openrouter uses https://openrouter.ai/api/v1
# and forces all three text aliases to openrouter/free, regardless of old alias/DB mappings.
# Random routed model/vision availability is not a production model identity or SLA.
# Images and speech remain DEMO, search is disabled (no paid search plugins or fallbacks).
# This mode is rejected outside UVMS_ENV=development/demo/test. Keep the key backend-only.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
UVMS_REQUIRE_LIVE_AI=false
# Production compose forces live AI unless this is explicitly overridden for staging.
UVMS_ALLOW_DEMO_IN_PRODUCTION=false
# Optional alias overrides. Blank uses the admin database mapping, seeded from OPENAI_MODEL.
# Nonblank environment override takes precedence over an admin provider-model edit.
UVMS_MODEL_FAST=
UVMS_MODEL_BALANCED=
UVMS_MODEL_DEEP=
# Conservative total budget: text UTF-8 bytes as token upper bound, 4096 per low-detail image,
# plus system/message overhead and output allowance. Choose limits supported by your models.
UVMS_CONTEXT_TOKENS=32768
UVMS_OUTPUT_TOKENS=4096
UVMS_PROVIDER_TIMEOUT_SECONDS=120
UVMS_IMAGE_TIMEOUT_SECONDS=240
UVMS_VISION_MAX_IMAGES=4
UVMS_VISION_MAX_PIXELS=25000000
# Backend-only pricing JSON keyed by provider model, numeric USD rates. Empty = UNKNOWN cost.
# Supported fields: input_per_million, output_per_million, per_search, per_image, per_second.
# Example shape: {"YOUR_MODEL":{"input_per_million":0,"output_per_million":0}}
# Replace example rates with verified provider rates; zero is only valid for truly free usage.
UVMS_PROVIDER_PRICES_JSON={}
# Seed defaults only; database feature controls take precedence after an admin changes them.
UVMS_SEARCH_ENABLED=true
UVMS_IMAGES_ENABLED=true
UVMS_VOICE_ENABLED=true
# Optional paid smoke runner only. Normal pytest/browser CI never invokes live providers.
UVMS_LIVE_PROVIDER_TESTS=0

# Web / Mobile
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Emulator/Web default only. A physical phone must use the PC LAN address for its Expo process,
# e.g. EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api/v1. Do not commit a developer IP.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
UVMS_PUBLIC_WEB_URL=http://localhost:3000

# Billing foundation. Demo is local/staging only and production checkout is blocked.
UVMS_BILLING_PROVIDER=demo
# Use disabled for a safe free-only production deployment until a real payment adapter is implemented.
UVMS_BILLING_WEBHOOK_SECRET=

# Password recovery. Production requires SMTP when enabled.
UVMS_PASSWORD_RESET_ENABLED=true
UVMS_PASSWORD_RESET_MINUTES=30
UVMS_SMTP_HOST=
UVMS_SMTP_PORT=587
UVMS_SMTP_USERNAME=
UVMS_SMTP_PASSWORD=
UVMS_SMTP_FROM=UVMS AI <no-reply@example.com>
UVMS_SMTP_STARTTLS=true

# Optional protected /metrics endpoint. Blank = open in local dev.
UVMS_METRICS_TOKEN=

# Development keeps automatic reference-data seeding convenient. Production
# Compose overrides this to false because app.prod_start migrates/seeds once
# before the Uvicorn worker pool starts, avoiding multi-worker seed races.
UVMS_SEED_ON_STARTUP=true

# Production compose variables
POSTGRES_DB=uvms_ai
POSTGRES_USER=uvms
POSTGRES_PASSWORD=CHANGE_ME_USE_RANDOM_POSTGRES_PASSWORD
UVMS_API_WORKERS=2
UVMS_GRACEFUL_SHUTDOWN_SECONDS=30
UVMS_KEEP_ALIVE_SECONDS=5

# Release metadata
UVMS_RELEASE_VERSION=1.4.3
