# UVMS AI v1.4 production example — copy to .env and replace every CHANGE_ME value.
UVMS_ENV=production
UVMS_RELEASE_VERSION=1.4.3

# Public origin
UVMS_PUBLIC_WEB_URL=https://ai.example.com
UVMS_CORS_ORIGINS=https://ai.example.com
UVMS_TRUSTED_HOSTS=ai.example.com,localhost,127.0.0.1
UVMS_REFRESH_COOKIE_SECURE=true

# Secrets
UVMS_JWT_SECRET=CHANGE_ME_RANDOM_48_PLUS_CHARACTERS
UVMS_METRICS_TOKEN=CHANGE_ME_RANDOM_32_PLUS_CHARACTERS
POSTGRES_DB=uvms_ai
POSTGRES_USER=uvms
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD

# Shared infrastructure
UVMS_REDIS_URL=redis://redis:6379/0
UVMS_API_WORKERS=2
UVMS_DB_POOL_SIZE=10
UVMS_DB_MAX_OVERFLOW=20
UVMS_GRACEFUL_SHUTDOWN_SECONDS=30
UVMS_KEEP_ALIVE_SECONDS=5

# Live AI is mandatory for a real production deployment.
UVMS_REQUIRE_LIVE_AI=true
UVMS_ALLOW_DEMO_IN_PRODUCTION=false
UVMS_AI_PROVIDER=groq
UVMS_PUBLIC_BETA=true
GROQ_API_KEY=CHANGE_ME_SERVER_SECRET_ONLY
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-120b
GROQ_MODEL_BALANCED=openai/gpt-oss-120b
GROQ_MODEL_DEEP=openai/gpt-oss-120b
GROQ_VISION_ENABLED=false
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
UVMS_SEARCH_ENABLED=false
UVMS_IMAGES_ENABLED=false
UVMS_VOICE_ENABLED=true
UVMS_BETA_DAILY_REQUESTS=10
UVMS_BETA_MINUTE_REQUESTS=5
UVMS_BETA_GLOBAL_CONCURRENCY=3
UVMS_BETA_CONTEXT_TOKENS=12000
UVMS_BETA_OUTPUT_TOKENS=1536
UVMS_BETA_EXTENDED_OUTPUT_TOKENS=2048
UVMS_OUTPUT_TOKENS=2048
UVMS_PROVIDER_TIMEOUT_SECONDS=90
UVMS_DOMAIN=ai.example.com

# Upload envelope
UVMS_MAX_UPLOAD_MB=20
UVMS_MAX_AUDIO_MB=25
UVMS_MAX_REQUEST_MB=105
UVMS_MAX_EXTRACTED_TEXT_CHARS=120000

# Single-server default. For horizontal scale, configure private S3/R2 instead.
UVMS_STORAGE_BACKEND=local
UVMS_STORAGE_DIR=/data/uploads

# Safe production default until a real payment adapter is implemented/certified.
UVMS_BILLING_PROVIDER=disabled

# Password reset: enable only after real SMTP is configured.
UVMS_PASSWORD_RESET_ENABLED=false
UVMS_SMTP_HOST=
UVMS_SMTP_PORT=587
UVMS_SMTP_USERNAME=
UVMS_SMTP_PASSWORD=
UVMS_SMTP_FROM=UVMS AI <no-reply@example.com>
UVMS_SMTP_STARTTLS=true
